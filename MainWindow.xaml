<Window x:Class="toggle_lang.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入法语言自动切换器" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="assets/icon.ico"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    
    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题和控制区域 -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       Style="{StaticResource HeaderTextStyle}"
                       Text="应用程序输入法配置"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="StartStopButton" 
                        Content="启动监控" 
                        Click="StartStopButton_Click"
                        Width="100"/>
                <CheckBox x:Name="AutoStartCheckBox"
                          Content="开机自启动"
                          VerticalAlignment="Center"
                          Margin="10,0,0,0"
                          Checked="AutoStartCheckBox_Changed"
                          Unchecked="AutoStartCheckBox_Changed"/>
                <Button x:Name="ShowLogButton"
                        Content="查看日志"
                        Click="ShowLogButton_Click"
                        Width="80"
                        Margin="10,0,0,0"
                        Background="#2196F3"
                        Foreground="White"/>
            </StackPanel>
        </Grid>

        <!-- 状态栏和快捷设置 -->
        <Border Grid.Row="1" 
                Background="#F0F0F0" 
                Padding="10" 
                CornerRadius="5"
                Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 当前状态显示 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Style="{StaticResource StatusTextStyle}"
                               Text="当前应用：" 
                               FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" 
                               x:Name="CurrentAppText"
                               Style="{StaticResource StatusTextStyle}"
                               Text="无"/>
                    
                    <TextBlock Grid.Column="2" 
                               Style="{StaticResource StatusTextStyle}"
                               Text="当前输入法：" 
                               FontWeight="Bold"
                               Margin="20,5,5,5"/>
                    <TextBlock Grid.Column="3" 
                               x:Name="CurrentLanguageText"
                               Style="{StaticResource StatusTextStyle}"
                               Text="无"/>
                </Grid>
                
                <!-- 快捷设置区域 -->
                <Border Grid.Row="2" 
                        Background="#E8F4F8" 
                        Padding="10" 
                        CornerRadius="3"
                        x:Name="QuickSetupBorder"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                   Text="快捷设置当前应用的输入法："
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   FontWeight="SemiBold"/>
                        
                        <ComboBox Grid.Column="1" 
                                  x:Name="QuickLanguageComboBox"
                                  Height="30"
                                  VerticalAlignment="Center"
                                  MaxWidth="250"
                                  HorizontalAlignment="Left"/>
                        
                        <Button Grid.Column="2" 
                                Content="设置为当前应用的默认输入法"
                                Click="QuickSetButton_Click"
                                Height="30"
                                Padding="15,5"
                                Margin="10,0,0,0"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 应用配置列表 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 添加新配置 -->
            <Border Grid.Row="0" 
                    Background="#E8F4F8" 
                    Padding="10" 
                    CornerRadius="5"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="应用名称" Margin="0,0,0,5"/>
                        <TextBox x:Name="NewAppNameTextBox" 
                                 Height="30"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Margin="5,0">
                        <TextBlock Text="进程名称（不含.exe）" Margin="0,0,0,5"/>
                        <TextBox x:Name="NewProcessNameTextBox" 
                                 Height="30"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" Margin="5,0,0,0">
                        <TextBlock Text="输入法语言" Margin="0,0,0,5"/>
                        <ComboBox x:Name="NewLanguageComboBox" 
                                  Height="30"
                                  SelectedIndex="0"/>
                    </StackPanel>
                    
                    <Button Grid.Column="3" 
                            Content="添加" 
                            Click="AddButton_Click"
                            Width="80"
                            VerticalAlignment="Bottom"
                            Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- 配置列表 -->
            <DataGrid Grid.Row="1"
                      x:Name="AppConfigDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="40"
                      AlternatingRowBackground="#F9F9F9"
                      CellEditEnding="AppConfigDataGrid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="启用" 
                                          Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                          Width="60"/>
                    <DataGridTextColumn Header="应用名称" 
                                      Binding="{Binding AppName, UpdateSourceTrigger=PropertyChanged}"
                                      Width="2*"
                                      IsReadOnly="False"/>
                    <DataGridTextColumn Header="进程名称" 
                                      Binding="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                      Width="2*"
                                      IsReadOnly="False"/>
                    <DataGridComboBoxColumn Header="输入法语言" 
                                          SelectedValueBinding="{Binding Language, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Code"
                                          DisplayMemberPath="Name"
                                          Width="2*"
                                          x:Name="LanguageColumn"/>
                    <DataGridTemplateColumn Header="操作" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="删除" 
                                        Click="DeleteButton_Click"
                                        Width="60"
                                        Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 底部说明 -->
        <TextBlock Grid.Row="3" 
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   FontSize="11"
                   Margin="0,15,0,0">
            <Run Text="使用说明："/>
            <LineBreak/>
            <Run Text="1. 点击'启动监控'开始自动切换输入法"/>
            <LineBreak/>
            <Run Text="2. 添加应用配置时，进程名称不需要包含.exe后缀"/>
            <LineBreak/>
            <Run Text="3. 可以在任务栏托盘中找到本程序图标，单击可显示/隐藏主窗口"/>
            <LineBreak/>
            <Run Text="4. 关闭窗口时程序将最小化到托盘，右键托盘图标可完全退出"/>
        </TextBlock>
    </Grid>
</Window>

