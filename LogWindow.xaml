<Window x:Class="toggle_lang.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="调试日志" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ClearButton" 
                        Content="清空日志" 
                        Click="ClearButton_Click"
                        Width="80"
                        Margin="0,0,10,0"/>
                <CheckBox x:Name="AutoScrollCheckBox"
                          Content="自动滚动"
                          IsChecked="True"
                          VerticalAlignment="Center"/>
                <TextBlock Text="  |  日志数量: " 
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
                <TextBlock x:Name="LogCountText" 
                           Text="0"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- 日志显示区域 -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="10">
            <ScrollViewer x:Name="LogScrollViewer" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="Black"
                         Foreground="LightGreen"
                         BorderThickness="0"
                         Padding="5"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

